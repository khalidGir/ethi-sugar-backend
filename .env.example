# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# JWT Configuration
JWT_SECRET="your-secure-jwt-secret-min-32-chars"

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# n8n Webhook URLs
N8N_WEBHOOK_INCIDENT="https://your-n8n-instance/webhook/incident"
N8N_WEBHOOK_IRRIGATION="https://your-n8n-instance/webhook/irrigation"

# Internal API Configuration
INTERNAL_API_TOKEN="your-internal-api-token"

# AI Service Configuration
AI_API_KEY="your-ai-api-key"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="ethiosugar@ethiosugar.com"
SMTP_PASS="your-app-password"
SMTP_FROM="EthioSugar Farm" <noreply@ethiosugar.com>

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Optional: Cloud Storage (for production)
# AWS_S3_BUCKET="your-bucket-name"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
