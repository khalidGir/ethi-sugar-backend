              "value": "Bearer {{$credentials.jwtToken}}"
            }
          ]
        }
      },
      "id": "get-summary",
      "name": "Get Dashboard Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300],
      "credentials": {
        "httpHeaderAuth": "ethiosugar-api"
      }
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/v1/weather/forecast"
      },
      "id": "get-weather",
      "name": "Get Weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 450]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/v1/incidents",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$credentials.jwtToken}}"
            }
          ]
        }
      },
      "id": "get-incidents",
      "name": "Get Today's Incidents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 600],
      "credentials": {
        "httpHeaderAuth": "ethiosugar-api"
      }
    },
    {
      "parameters": {
        "functionCode": "// Collect all data and format report\nconst summary = $('Get Dashboard Summary').first().json.data || {};\nconst weather = $('Get Weather').first().json.data || {};\nconst incidentsData = $('Get Today's Incidents').first().json.data || [];\n\nconst today = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });\n\n// Calculate task completion rate\nconst totalTasks = summary.pendingTasks + summary.completedTasks;\nconst completionRate = totalTasks > 0 ? Math.round((summary.completedTasks / totalTasks) * 100) : 0;\n\n// Weather summary\nconst tomorrow = weather.forecast?.[1];\nconst rainChance = tomorrow ? (tomorrow.rainfallMm > 0 ? 'Yes' : 'No') : 'Unknown';\n\n// Format message\nlet message = `📊 <b>Daily Farm Summary - ${today}</b>\\n\\n`;\n\nmessage += `🌾 <b>Tasks</b>\\n`;\nmessage += `   ✅ Completed: ${summary.completedTasks || 0}\\n`;\nmessage += `   ⏳ Pending: ${summary.pendingTasks || 0}\\n`;\nmessage += `   📈 Completion: ${completionRate}%\\n\\n`;\n\nmessage += `🌧️ <b>Weather</b>\\n`;\nmessage += `   📍 Location: ${weather.location || 'Addis Ababa'}\\n`;\nmessage += `   🌡️ Temp: ${weather.forecast?.[0]?.temperatureMax || '--'}°C\\n`;\nmessage += `   🌧️ Rain Tomorrow: ${rainChance}\\n`;\nmessage += `   💡 ${weather.recommendation || 'Normal operations'}\\n\\n`;\n\nmessage += `🦠 <b>Incidents</b>\\n`;\nmessage += `   ⚠️ Open: ${summary.openIncidents || 0}\\n`;\nmessage += `   📋 Total Today: ${incidentsData.length}\\n\\n`;\n\nmessage += `📍 <b>Fields</b>\\n`;\nmessage += `   🌱 Total: ${summary.totalFields || 0}\\n`;\n\nmessage += `---\\n<i>Generated by EthioSugar Automation</i>`;\n\nreturn [{\n  json: {\n    message\n  }\n}];"
      },
      "id": "format-report",
      "name": "Format Report",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 450]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{$credentials.telegramBotToken}}/sendMessage",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "Khalidblabla"
            },
            {
              "name": "text",
              "value": "{{$json.message}}"
            },
            {
              "name": "parse_mode",
              "value": "HTML"
            }
          ]
        }
      },
      "id": "send-report",
      "name": "Send to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 450],
      "credentials": {
        "telegramBotApi": "ethiosugar-telegram"
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "functionCode": "// Error handler\nreturn {\n  json: {\n    error: $input.first().json.error || 'Unknown error',\n    workflow: 'Daily Summary Report'\n  }\n};"
      },
      "id": "error-handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [850, 600],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{$credentials.telegramBotToken}}/sendMessage",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "Khalidblabla"
            },
            {
              "name": "text",
              "value": "🚨 <b>Workflow Error</b>\n\nWorkflow: Daily Summary Report\nError: {{$json.error}}"
            },
            {
              "name": "parse_mode",
              "value": "HTML"
            }
          ]
        }
      },
      "id": "alert-admin",
      "name": "Alert Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1050, 600],
      "credentials": {
        "telegramBotApi": "ethiosugar-telegram"
      }
    }
  ],
